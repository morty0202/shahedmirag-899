# Frontend (Vite) — copy to .env and adjust
# Base URL of the backend REST API (server/server.mjs)
VITE_API_URL=http://localhost:3001

# URL of the classroom signaling server (the same combined backend)
# Use the LAN IP for testing from other devices, e.g. http://192.168.1.6:3001
VITE_SIGNAL_URL=http://localhost:3001

# remote (default when URL set) | local (BroadcastChannel dev-only) | auto
VITE_SIGNALING_MODE=auto

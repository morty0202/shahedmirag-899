# Signaling server environment — copy to server/.env (or export in systemd/pm2)

# Required in production: secret used to sign auth tickets.
#   openssl rand -hex 32
SIGNAL_SECRET=

# Listen port
PORT=8081

# CORS origin allowed to call /api/auth/login (frontend origin)
ALLOWED_ORIGIN=http://localhost:5175

# --- TURN (needed when students are behind strict NAT / symmetric routers) ---
# coturn REST-style credentials. The secret NEVER leaves this server; the
# server mints short-lived username/password pairs for clients.
# TURN_URL=turn:turn.example.school:3478?transport=udp,turns:turn.example.school:5349?transport=tcp
# TURN_SECRET=
# TURN_TTL_SEC=21600
# --- OpenAI (AI assistant) ---
# Get your key from https://platform.openai.com/api-keys
# The key is read ONLY server-side. Never expose it in client code.
# Works with any OpenAI-compatible provider, e.g. OpenRouter (has free models):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=45000
